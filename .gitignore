.DS_Store
*.swp
*.swo
.idea/
.vscode/
node_modules/
__pycache__/
*.pyc

# Lens build artefacts (vendored under lens/)
lens/target/
lens/**/*.rs.bk

# Lens graphify analysis cache — regenerable from `graphify lens/`. The hashed
# JSON files under graphify-out/cache/ are not source; bump the vendor SHA in
# lens/VENDOR.txt rather than committing them.
lens/**/graphify-out/
.lens/

# All Markdown files — user request
tmp/
*.md

# ...except the skill payload's markdown, which is source, not notes. SKILL.md
# points at every file under pro-coder/references/ and install.sh ships them;
# excluded, a fresh clone would install a skill whose pointers resolve to
# nothing. (SKILL.md, README.md, CHANGELOG.md and CLAUDE.md predate the rule and
# stay tracked because *.md does not apply to already-tracked files.)
!pro-coder/**/*.md

# pro-coder lens-first guard marker — machine-local, arms the PreToolUse hook.
# Not committed: whether the guard is armed is a property of a working copy,
# not of the project.
.claude/state/pro-coder-guard
